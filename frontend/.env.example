# Frontend Environment Variables
# Copy this to .env.local and fill in your values

# Supabase (from Project Settings > API in the Supabase dashboard)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Backend API URL
# Development: leave empty to use Vite proxy (/api → http://localhost:3001)
# Production:  MUST include /api suffix, e.g. https://polla-backend.onrender.com/api
VITE_API_URL=
