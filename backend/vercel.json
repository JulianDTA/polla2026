{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server.js" }
  ],
  "crons": [
    {
      "path": "/api/admin/sync-live",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/admin/calculate-points",
      "schedule": "*/10 * * * *"
    }
  ]
}
