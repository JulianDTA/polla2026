{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server.js" }
  ],
  "crons": [
    {
      "path": "/api/admin/cron/sync-live",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/admin/cron/sync-all",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/admin/cron/calculate-points",
      "schedule": "30 2 * * *"
    }
  ]
}
