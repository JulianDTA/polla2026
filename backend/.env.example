# ============================================================
# POLLA MUNDIALISTA 2026 - Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS) - set to your Render static site URL in production
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here   # Secret – never expose publicly
SUPABASE_ANON_KEY=your_anon_key_here

# FIFA / API-Football
# Get your key at https://www.api-football.com/ or https://rapidapi.com/api-sports/api/api-football
FIFA_API_KEY=your_api_football_key_here
FIFA_API_BASE_URL=https://v3.football.api-sports.io
# If using RapidAPI host instead:
# FIFA_API_BASE_URL=https://api-football-v1.p.rapidapi.com/v3
# RAPIDAPI_HOST=api-football-v1.p.rapidapi.com

# Admin secret (used to protect the /api/admin/* routes)
# Generate a strong random string, e.g.: openssl rand -hex 32
ADMIN_SECRET_KEY=change_me_to_a_strong_random_secret
